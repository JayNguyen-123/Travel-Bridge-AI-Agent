# .env.example -- copy to a local, untracked `.env` (or `adk.env`) file.
# NEVER commit real values here, and never paste real values into a notebook
# or any file that might get uploaded, emailed, or shared. Use Secret Manager
# (see deploy/DEPLOY.md) for anything deployed.

# 1. Google Gemini / ADK
GEMINI_API_KEY=AIzaSyYourGcpSecretGeminiApiKeyHere
ADK_MODEL=gemini-3.1-flash-live-preview

# 2. Amadeus Self-Service API
# Sandbox host while developing; switch to https://api.amadeus.com only after
# completing Amadeus's "moving to production" process.
AMADEUS_BASE_URL=https://test.api.amadeus.com
AMADEUS_ACCESS_TOKEN=YourLiveAmadeusOAuthBearerTokenHere

# 3. PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=travel_db
DB_USER=postgres
DB_PASSWORD=YourSecureDatabasePasswordHere
DB_POOL_MIN=1
DB_POOL_MAX=10

# 4. Twilio (SMS: booking confirmations + payment links)
TWILIO_ACCOUNT_SID=ACyourActualTwilioAccountSidHere
TWILIO_AUTH_TOKEN=yourActualTwilioAuthTokenStringHere
TWILIO_PHONE_NUMBER=+12345678901

# 4b. SendGrid (email: flight itinerary/e-ticket-style confirmation, sent
# right after a real Amadeus booking succeeds -- see notifications/email.py
# and the "who sends the itinerary" note in README.md). Leave unset to skip
# email entirely -- the booking still succeeds and the SMS confirmation
# still goes out; send_flight_itinerary_email just logs a warning and
# returns {"sent": False}, same fail-open pattern as Twilio above.
SENDGRID_API_KEY=SG.YourActualSendGridApiKeyHere
SENDGRID_FROM_EMAIL=bookings@your-verified-sending-domain.example.com

# 5. Stripe (payment collection)
STRIPE_SECRET_KEY=sk_test_YourStripeSecretKeyHere
STRIPE_WEBHOOK_SECRET=whsec_YourStripeWebhookSigningSecretHere
CHECKOUT_SUCCESS_URL=https://your-domain.example.com/payment-success
CHECKOUT_CANCEL_URL=https://your-domain.example.com/payment-cancelled

# 6. Misc
LOG_LEVEL=INFO
PORT=8080

# Optional: an internal phone number that gets a text whenever a customer
# logs a cancellation-refund-review or change/support request (see
# tools/support_tools.py), or when the booking failure-resolution engine
# escalates to Tier 4 (see below). Leave unset to skip this and rely on
# querying the support_requests table / the admin UI directly instead.
OPS_NOTIFICATION_PHONE=

# 7. Admin UI (server/admin.py) -- works the support_requests queue and any
# booking still awaiting a manual refund decision, at GET /admin. HTTP Basic
# auth: any username, this value as the password. Leave unset to disable the
# admin UI entirely (it fails closed with 503, not open). This is a single
# shared secret suitable for one or two internal ops people hitting a URL
# that isn't publicly advertised -- NOT real per-agent login/RBAC. Rotate it
# like any shared credential, and see PRODUCTION_CHECKLIST.md before this is
# used by a wider team.
ADMIN_API_KEY=

# 8. Booking failure-resolution engine (tools/booking_tools.py) -- what
# happens if payment succeeds but the Amadeus booking call itself fails.
# BOOKING_RETRY_ATTEMPTS: extra attempts (beyond the first) for Tier 1's
#   retry, only on errors that look transient (network error, Amadeus
#   429/5xx). Total attempts = 1 + this value.
BOOKING_RETRY_ATTEMPTS=2
# BOOKING_RETRY_BACKOFF_SECONDS: base delay between Tier 1 retries (scales
#   with attempt number: 1x, 2x, 3x...).
BOOKING_RETRY_BACKOFF_SECONDS=1.5
# FARE_REBOOK_THRESHOLD_PERCENT: in Tier 2, how much more (as a percentage
#   of what the customer already paid) the business will absorb to rebook a
#   comparable fare automatically, without charging the customer again.
#   Above this, Tier 2 gives up and Tier 3 (auto-refund) takes over.
FARE_REBOOK_THRESHOLD_PERCENT=10
